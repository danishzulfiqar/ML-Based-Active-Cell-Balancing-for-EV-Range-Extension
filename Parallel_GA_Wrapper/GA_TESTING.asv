clc
clear
close all

warning('off', 'all'); % Suppress all warnings

% Define number of variables (weights)
nvars = 4;

% Lower and upper bounds for weights
lb = [0, 0, 0, 0];  % Minimum values
ub = [1, 1, 1, 0.0001]; % Maximum values

% GA options
options = optimoptions('ga', ...
    'PopulationSize', 2, ...          % Population size
    'MaxGenerations', 2, ...         % Maximum generations
    'CrossoverFraction', 0.8, ...      % Crossover rate
    'MutationFcn', {@mutationuniform, 0.2}, ... % Uniform mutation with a rate of 0.1
    'Display', 'iter', ...             % Display optimization progress
    'UseParallel', false);              % Enable parallel computing

% Run the GA
[optimal_weights, fval] = ga(@objective_function, nvars, [], [], [], [], lb, ub, [], options);

% Display results
fprintf('Optimal Weights: w1=%.4f, w2=%.4f, w3=%.4f, wPL=%.6f\n', ...
    optimal_weights(1), optimal_weights(2), optimal_weights(3), optimal_weights(4));
fprintf('Maximum Range Achieved: %.2f\n', -fval);



